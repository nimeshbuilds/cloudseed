#!/usr/bin/env python3
"""cloudseed launcher (also the PyInstaller entry point). Works when symlinked onto PATH."""
import os
import sys

if sys.version_info < (3, 9):  # keep this check parseable by old interpreters: no f-strings above the import below
    sys.stderr.write("cloudseed needs Python 3.9 or newer (this is %s at %s).\n"
                     "Install a newer python3 (macOS: brew install python; Debian/Ubuntu: apt install python3) and re-run.\n"
                     % (sys.version.split()[0], sys.executable))
    sys.exit(1)

_HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.dirname(_HERE))

from cloudseed.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
