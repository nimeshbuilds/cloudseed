#!/usr/sbin/nft -f
# managed by cloudseed - host firewall for the bastion
flush ruleset

table inet filter {
  set ssh_allowed {
    type ipv4_addr
    flags interval
    # overlapping or adjacent allow-list entries (198.51.100.0/24 + 198.51.100.7) are merged instead of rejected
    auto-merge
{% if allowed_ssh_cidrs | length > 0 %}
    elements = { {{ allowed_ssh_cidrs | join(', ') }} }
{% endif %}
  }

  chain input {
    type filter hook input priority 0; policy drop;
    iif "lo" accept
    ct state established,related accept
    ct state invalid drop
    ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded, parameter-problem } accept
    ip6 nexthdr icmpv6 accept
{% if allowed_ssh_cidrs | length > 0 %}
    ip saddr @ssh_allowed tcp dport 22 ct state new accept
{% elif ssh_open_any | default(false) | bool %}
    tcp dport 22 ct state new accept
{% endif %}
{% for port in (extra_udp_ports | default([])) %}
    udp dport {{ port }} accept
{% endfor %}
{% if vpn_forward | default(false) %}
    iifname { "tun0", "tailscale0" } accept
{% endif %}
{% for cidr in (nat_source_cidrs | default([])) %}
    ip saddr {{ cidr }} accept
{% endfor %}
    ip saddr 169.254.169.254 accept
    counter drop
  }

  chain forward {
    type filter hook forward priority 0; policy drop;
{% if vpn_forward | default(false) or (nat_source_cidrs | default([])) | length > 0 %}
    ct state established,related accept
{% endif %}
{% if vpn_forward | default(false) %}
    iifname { "tun0", "tailscale0" } accept
{% endif %}
{% for cidr in (nat_source_cidrs | default([])) %}
    ip saddr {{ cidr }} accept
{% endfor %}
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}
{% if vpn_forward | default(false) or (nat_source_cidrs | default([])) | length > 0 %}

table ip nat {
  chain postrouting {
    type nat hook postrouting priority 100; policy accept;
{% if vpn_forward | default(false) %}
    iifname { "tun0", "tailscale0" } oifname != { "tun0", "tailscale0" } masquerade
{% endif %}
{% for cidr in (nat_source_cidrs | default([])) %}
    ip saddr {{ cidr }} oifname != { "tun0", "tailscale0" } masquerade
{% endfor %}
  }
}
{% endif %}
